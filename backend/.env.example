# ==============================================================================
# FreightIQ Backend Environment Variables
# ==============================================================================
# All datasets and rate predictions are DEMO / SYNTHETIC for hackathon/dev use.
# Do NOT use for live trading, financial decisions, or physical fixture bookings.
# ==============================================================================

# Database Connection (SQLite by default; supports postgresql://user:pass@host:5432/freightiq)
DATABASE_URL=sqlite:///./freightiq.db

# Application Runtime Mode (development | staging | production)
ENVIRONMENT=development

# Synthetic / Demo Mode Flag (enforces explicit [DEMO] labeling across responses)
DEMO_MODE=true

# Allowed CORS Origins (comma-separated for Next.js frontend or local dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Listening Port & Host
PORT=8000
HOST=0.0.0.0

# Logging Verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
